# LLM配置-DeepSeek(自然语言生成模型)
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TEMPERATURE=0.3
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TOP_P=1.0

# embedding配置-GLM(嵌入模型-embedding-3)
GLM_API_KEY=your_glm_api_key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/embeddings
GLM_MODEL=embedding-3
GLM_EMBEDDING_DIMENSIONS=2048
GLM_EMBEDDING_BATCH_SIZE=32

# ChromaDB配置(向量数据库)
# mode: local=进程内持久化 | http=独立server(VectorDBZ等可视化工具可连 http://127.0.0.1:8001)
# 注意: CHROMA_PERSIST_DIR 相对于 backend 目录; http 模式下 chroma server 启动参数 --path 需指向同一目录
CHROMA_MODE=http
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=campus_kb
CHROMA_HTTP_HOST=127.0.0.1
CHROMA_HTTP_PORT=8001

# MySQL配置(文档元数据与分片存储)
# 本机直连: MYSQL_HOST=127.0.0.1; Docker部署: 由 compose 覆盖为容器服务名
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=cityu_rag
# Docker 部署时容器 MySQL 的 root 密码(backend 会自动使用同一密码)
MYSQL_ROOT_PASSWORD=cityu_rag_root

# 应用与认证(JWT管理员登录)
APP_SECRET_KEY=please-generate-a-64-hex-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-use-a-strong-password

# 安全与限流(CORS来源逗号分隔; 上传上限MB; 每IP每分钟问答/普通请求次数)
ALLOWED_ORIGINS=*
MAX_UPLOAD_MB=20
RATE_LIMIT_CHAT_PER_MIN=5
RATE_LIMIT_API_PER_MIN=120

# 检索配置
RETRIEVAL_TOP_K=8
HYBRID_ENABLED=true
RRF_K=60
RERANK_ENABLED=false

# 分块与文档预处理配置
CHUNK_SIZE=600
CHUNK_OVERLAP=120
DOC_CLEAN_ENABLED=true

# 记忆配置
MEMORY_WINDOW_MESSAGES=12
MEMORY_SUMMARY_TRIGGER=20
